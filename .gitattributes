# Auto-detect text files and normalize line endings
* text=auto

# Text files with explicit LF line endings
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.env* text eol=lf

# Binary files - Never convert line endings
*.pdf binary
*.xlsx binary
*.xls binary
*.zip binary
*.tar.gz binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pyc binary
*.db binary
*.sqlite binary
